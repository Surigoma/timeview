{
  "name": "timeview-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit && oxlint src",
    "fmt": "prettier --write src *.json *.ts *.js index.html",
    "test": "node --experimental-strip-types --test src/i18n.test.ts src/input/bindings.test.ts src/timer/timer.test.ts src/timer/useTimer.test.ts src/timer/events.test.ts"
  },
  "dependencies": {
    "i18next": "27.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.95.0",
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
