{
  "openapi": "3.1.0",
  "info": {
    "title": "TimeView API",
    "version": "0.2.0",
    "description": "分離LAN向け認証なしHTTP API。タイマー実行状態と再送記録はメモリ、設定はJSONファイルへ保存。POST/PUT/PATCHはapplication/json、本文16KiB以内。変更APIはIPごと10件/秒・バースト20、GETはIPごと30件/秒。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080/api/v1"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "起動済み",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 JSON/Content-Type不正、404 未知API、409 状態/キー/起動ID競合、412 ETag不一致、413 本文16KiB超過、422 値不正、428 必須ヘッダー欠落、429 レート/容量制限、500 内部エラー",
            "headers": {
              "Retry-After": {
                "description": "429時の待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timer": {
      "get": {
        "operationId": "getTimer",
        "responses": {
          "200": {
            "description": "最新状態。同じキーの再送は最初の応答。",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用符付きinstanceId:version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Timer"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON/Content-Type不正、404 未知API、409 状態/キー/起動ID競合、412 ETag不一致、413 本文16KiB超過、422 値不正、428 必須ヘッダー欠落、429 レート/容量制限、500 内部エラー",
            "headers": {
              "Retry-After": {
                "description": "429時の待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateSettings",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "要求ごとのUUID等。adjustでは必須。全クライアント共通の名前空間で同一起動中10分間保持。同じキー・メソッド・パス・本文バイト列で再送。",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "引用符付きinstanceId:version。不一致412。PATCHでは必須。",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "X-Timeview-Instance",
            "in": "header",
            "description": "取得したinstanceId。再起動による不一致時は409。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "durationSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400,
                    "description": "idleのみ変更可能"
                  },
                  "warning1Seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  },
                  "warning2Seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  },
                  "displayMode": {
                    "type": "string",
                    "enum": [
                      "timer",
                      "timer_and_message",
                      "message"
                    ]
                  },
                  "flash": {
                    "type": "boolean"
                  },
                  "colors": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "normal",
                      "warning1",
                      "warning2",
                      "overtime"
                    ],
                    "properties": {
                      "normal": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "warning1": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "warning2": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "overtime": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "最新状態。同じキーの再送は最初の応答。",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用符付きinstanceId:version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Timer"
                }
              }
            }
          },
          "default": {
            "description": "400 JSON/Content-Type不正、404 未知API、409 状態/キー/起動ID競合、412 ETag不一致、413 本文16KiB超過、422 値不正、428 必須ヘッダー欠落、429 レート/容量制限、500 内部エラー",
            "headers": {
              "Retry-After": {
                "description": "429時の待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timer/commands": {
      "post": {
        "operationId": "executeCommand",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "要求ごとのUUID等。adjustでは必須。全クライアント共通の名前空間で同一起動中10分間保持。同じキー・メソッド・パス・本文バイト列で再送。",
