  "components": {
    "schemas": {
      "Timer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "version",
          "state",
          "durationSeconds",
          "remainingMs",
          "serverTimeMs",
          "warning1Seconds",
          "warning2Seconds",
          "message",
          "displayMode",
          "blackout",
          "flash",
          "colors"
        ],
        "properties": {
          "instanceId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "paused"
            ]
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "remainingMs": {
            "type": "integer"
          },
          "serverTimeMs": {
            "type": "integer"
          },
          "warning1Seconds": {
            "type": "integer",
            "minimum": 0
          },
          "warning2Seconds": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "visible"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "visible": {
                "type": "boolean"
              }
            }
          },
          "displayMode": {
            "type": "string",
            "enum": [
              "timer",
              "timer_and_message",
              "message"
            ]
          },
          "blackout": {
            "type": "boolean",
            "default": true
          },
          "flash": {
            "type": "boolean",
            "default": false
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "normal",
              "warning1",
              "warning2",
              "overtime"
            ],
            "properties": {
              "normal": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "warning1": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "warning2": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "overtime": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      },
      "KeyBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "code",
          "ctrl",
          "shift",
          "alt",
          "meta"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "add",
              "subtract",
              "reset",
              "hide",
              "show",
              "clear",
              "blackout",
              "reveal",
              "preset0",
              "preset1",
              "preset2",
              "preset3",
              "preset4",
              "preset5",
              "preset6",
              "preset7",
              "preset8"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "ctrl": {
            "type": "boolean"
          },
          "shift": {
            "type": "boolean"
          },
          "alt": {
            "type": "boolean"
          },
          "meta": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
