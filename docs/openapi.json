            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Timeview-Instance",
            "in": "header",
            "description": "取得したinstanceId。再起動による不一致時は409。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "command"
                    ],
                    "properties": {
                      "command": {
                        "type": "string",
                        "enum": [
                          "start",
                          "pause",
                          "reset"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "command",
                      "deltaSeconds"
                    ],
                    "properties": {
                      "command": {
                        "type": "string",
                        "const": "adjust"
                      },
                      "deltaSeconds": {
                        "type": "integer",
                        "minimum": -3600,
                        "maximum": 3600,
                        "not": {
                          "const": 0
                        },
                        "description": "Idempotency-Key必須。変更後の残り時間は±24時間以内。"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "最新状態。同じキーの再送は最初の応答。",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "引用符付きinstanceId:version"
              }
            },
            "content": {
